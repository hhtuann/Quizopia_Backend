# Quizopia_Backend environment TEMPLATE — never put real credentials in Git.
# This file is reference-only. Spring Boot does NOT automatically read .env files.
# For local IDE/mvnw runs, export variables in the process/IDE run configuration.
# When using Quizopia_System/docker-compose.yml, configure the PARENT .env instead.

# Local PostgreSQL / Redis (only for running backend outside Compose).
DB_URL=jdbc:postgresql://localhost:5432/quizopia_db
DB_USERNAME=quiz_user
DB_PASSWORD=quiz_password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=redis_password

# REQUIRED. Base64 JWT key (>= 32 random decoded bytes) and AES-256-GCM key
# (exactly 32 random decoded bytes). Generate and keep stable for existing data.
# openssl rand -base64 48
QUIZOPIA_JWT_SECRET_BASE64=__replace_with_random_base64_jwt_secret__
# openssl rand -base64 32
QUIZOPIA_DATA_ENCRYPTION_KEY_BASE64=__replace_with_random_base64_32_byte_key__
QUIZOPIA_ALLOWED_ORIGINS=http://localhost:3000
QUIZOPIA_COOKIE_SECURE=false

# Identity M1 / M5: Mailpit for local backend running on the HOST.
QUIZOPIA_SMTP_HOST=localhost
QUIZOPIA_SMTP_PORT=1025
QUIZOPIA_MAIL_FROM=Quizopia <no-reply@quizopia.local>
QUIZOPIA_PASSWORD_RESET_FRONTEND_BASE_URI=http://localhost:3000

# Optional Google OAuth. Leave both credentials empty to disable Google login.
QUIZOPIA_GOOGLE_CLIENT_ID=
QUIZOPIA_GOOGLE_CLIENT_SECRET=
QUIZOPIA_OAUTH_FRONTEND_REDIRECT_URL=http://localhost:3000/auth/callback
QUIZOPIA_OAUTH_REDIRECT_BASE_URI=http://localhost:8080

# Development-only demo seed; never enable in production.
QUIZOPIA_DEMO_DATA_ENABLED=false

# Phase 4: monitoring & media (disabled until explicitly configured).
QUIZOPIA_AI_INGEST_KEY=
QUIZOPIA_LIVEKIT_ENABLED=false
QUIZOPIA_LIVEKIT_API_KEY=
QUIZOPIA_LIVEKIT_API_SECRET=
QUIZOPIA_LIVEKIT_HTTP_URL=http://localhost:7880
QUIZOPIA_LIVEKIT_WS_URL=ws://localhost:7880
QUIZOPIA_EVIDENCE_MINIO_ENDPOINT=http://localhost:9000
QUIZOPIA_EVIDENCE_MINIO_EGRESS_ENDPOINT=http://host.docker.internal:9000
QUIZOPIA_EVIDENCE_MINIO_ACCESS_KEY=
QUIZOPIA_EVIDENCE_MINIO_SECRET_KEY=
QUIZOPIA_EVIDENCE_BUCKET=quizopia-evidence
QUIZOPIA_FFMPEG_COMMAND=ffmpeg

# ---------------------------------------------------------------------
# Phase 5: AI-assisted Quiz Markdown authoring (issues #112/#113).
# Server-side ONLY - never expose these to the frontend or commit values.
# Until OPENAI_API_KEY is set the feature reports available=false (503 on
# authoring calls); QUIZOPIA_AI_AUTHORING_PROVIDER=mock is TEST-ONLY.
# ---------------------------------------------------------------------
QUIZOPIA_AI_AUTHORING_ENABLED=true
QUIZOPIA_AI_AUTHORING_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
